{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: {
    enabled: true,
  },
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  automergeStrategy: 'squash',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  enabledManagers: [
    'gradle',
    'gradle-wrapper',
    'github-actions',
    'docker-compose',
    'devcontainer',
    'nix',
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'gradle',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      schedule: [
        'on the first day of the month',
      ],
      automerge: false,
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchPackageNames: [
        'io.prometheus:**',
      ],
      groupName: 'Prometheus Java client',
    },
    {
      matchPackageNames: [
        'me.earth.headlessmc:hmc-specifics-api',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'io.github.headlesshq:headlessmc-**',
        'info.picocli:picocli',
        'org.apache.logging.log4j:**',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
  ],
}
