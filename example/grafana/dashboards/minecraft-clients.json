    {
      "type": "table",
      "title": "Clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per client. Click a client to open its dashboard.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (up{job=\"minecraft\", client=~\"$client\", client!=\"\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, version) (label_replace(hmc_client_version_info{client=~\"$client\", client!=\"\"}, \"version\", \"$1\", \"value\", \"(.*)\"))",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, player) (label_replace(hmc_player_name_info{client=~\"$client\", client!=\"\"}, \"player\", \"$1\", \"value\", \"(.*)\"))",
          "refId": "D",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, server) (label_replace(hmc_server_address_info{client=~\"$client\", client!=\"\"}, \"server\", \"$1\", \"value\", \"(.*)\")) or max by (client, server) (label_replace(hmc_server_singleplayer{client=~\"$client\", client!=\"\"} == 1, \"server\", \"Singleplayer\", \"client\", \".*\"))",
          "refId": "E",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, dimension) (label_replace(hmc_world_dimension_info{client=~\"$client\", client!=\"\"}, \"dimension\", \"$1\", \"value\", \"(.*)\"))",
          "refId": "F",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_client_fps{client=~\"$client\", client!=\"\"})",
          "refId": "G",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_server_tps{client=~\"$client\", client!=\"\"})",
          "refId": "H",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_server_ping{client=~\"$client\", client!=\"\"})",
          "refId": "I",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_player_health{client=~\"$client\", client!=\"\"})",
          "refId": "J",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_players_count{client=~\"$client\", client!=\"\"})",
          "refId": "K",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * max by (client) (jvm_memory_used_bytes{area=\"heap\", client=~\"$client\", client!=\"\"}) / max by (client) (jvm_memory_max_bytes{area=\"heap\", client=~\"$client\", client!=\"\"})",
          "refId": "L",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client) (hmc_main_thread_latency_seconds{client=~\"$client\", client!=\"\"})",
          "refId": "M",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
